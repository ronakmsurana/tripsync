{
  "name": "tripsync",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:css": "node scripts/build-css.js",
    "predev": "node scripts/build-css.js",
    "prebuild": "node scripts/build-css.js",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:mongo": "tsx scripts/setup-mongo.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reindex": "tsx scripts/reindex.ts",
    "db:setup": "npm run db:migrate && npm run db:mongo && npm run db:seed",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:api": "vitest run --project api",
    "test:all": "vitest run",
    "verify:embeddings": "tsx scripts/verify-embeddings.ts",
    "postinstall": "prisma generate",
    "test:ui": "node tests/e2e/ui.e2e.mjs",
    "docs:er": "node scripts/gen-er-diagram.mjs",
    "docs:dictionary": "node scripts/gen-data-dictionary.mjs",
    "docs:mongo": "node docs/mongo/aggregations.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.13",
    "mongodb": "^6.21.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "pgvector": "^0.3.0",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "selenium-webdriver": "^4.51.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
