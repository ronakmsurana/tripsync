# ---- PostgreSQL (source of truth + pgvector) ----
DATABASE_URL="postgresql://tripsync:CHANGE_ME@localhost:5432/tripsync"

# ---- MongoDB (activity documents) ----
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB="tripsync"

# ---- Auth ----
# Generate with: openssl rand -base64 48   (min 32 characters, never commit the real value)
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS"
JWT_EXPIRES_IN="7d"

# ---- Semantic search (local sentence-transformer, no API key) ----
EMBEDDING_ENABLED="true"
EMBEDDING_MODEL="Xenova/all-MiniLM-L6-v2"
EMBEDDING_TIMEOUT_MS="60000"

# ---- Seed script only (never used by the running app) ----
SEED_DEMO_PASSWORD="CHANGE_ME_demo_password_1"
SEED_ADMIN_EMAIL="admin@tripsync.local"
SEED_ADMIN_PASSWORD="CHANGE_ME_admin_password_1"
