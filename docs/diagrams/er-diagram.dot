  accommodations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#0f172a"><TR><TD COLSPAN="3" BGCOLOR="#0f172a"><FONT COLOR="white"><B>accommodations</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="accommodation_id"><B>accommodation_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#b45309"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="trip_id"><B>trip_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#b45309"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="destination_id"><B>destination_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#b45309"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name"><B>name</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(200)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="address"><B>address</B> ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(500)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="check_in"><B>check_in</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamp</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="check_out"><B>check_out</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamp</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="booking_reference"><B>booking_reference</B> ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(100)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="cost"><B>cost</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">numeric(12,2)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="status"><B>status</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(20)</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  activity_embeddings [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#0f172a"><TR><TD COLSPAN="3" BGCOLOR="#0f172a"><FONT COLOR="white"><B>activity_embeddings</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="embedding_id"><B>embedding_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#b45309"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="mongo_doc_id"><B>mongo_doc_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(24)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="trip_id"><B>trip_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#b45309"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="title"><B>title</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(200)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="content"><B>content</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">text</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="embedding"><B>embedding</B> ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">vector(384)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="embedding_model"><B>embedding_model</B> ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(100)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="sync_status"><B>sync_status</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(10)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="search_vector"><B>search_vector</B> ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">tsvector</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at"><B>updated_at</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamp</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  budgets [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#0f172a"><TR><TD COLSPAN="3" BGCOLOR="#0f172a"><FONT COLOR="white"><B>budgets</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="budget_id"><B>budget_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#b45309"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="trip_id"><B>trip_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#b45309"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category"><B>category</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(50)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="planned_amount"><B>planned_amount</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">numeric(12,2)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="remarks"><B>remarks</B> ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">text</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  destinations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#0f172a"><TR><TD COLSPAN="3" BGCOLOR="#0f172a"><FONT COLOR="white"><B>destinations</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="destination_id"><B>destination_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#b45309"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="trip_id"><B>trip_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#b45309"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name"><B>name</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(200)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="location"><B>location</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(300)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="arrival_date"><B>arrival_date</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">date</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="departure_date"><B>departure_date</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">date</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="notes"><B>notes</B> ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">text</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
