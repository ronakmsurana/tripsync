digraph ER {
  graph [rankdir=LR, splines=true, nodesep=0.35, ranksep=1.1, fontname="Helvetica", labelloc=t, label="TripSync — PostgreSQL entity-relationship diagram (generated from the live schema)", fontsize=18, pad=0.3];
  node [shape=plain, fontname="Helvetica", fontsize=10];
