</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  trip_members [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#0f172a"><TR><TD COLSPAN="3" BGCOLOR="#0f172a"><FONT COLOR="white"><B>trip_members</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="trip_id"><B>trip_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#b45309"><B>PK,FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><B>user_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#b45309"><B>PK,FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="member_role"><B>member_role</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(20)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="joined_at"><B>joined_at</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamp</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="status"><B>status</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(20)</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  trips [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#0f172a"><TR><TD COLSPAN="3" BGCOLOR="#0f172a"><FONT COLOR="white"><B>trips</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="trip_id"><B>trip_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#b45309"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="trip_name"><B>trip_name</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(200)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="description"><B>description</B> ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">text</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="start_date"><B>start_date</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">date</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="end_date"><B>end_date</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">date</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="currency"><B>currency</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">char(3)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="status"><B>status</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(20)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="created_by"><B>created_by</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#b45309"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><B>created_at</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamp</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at"><B>updated_at</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamp</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#0f172a"><TR><TD COLSPAN="3" BGCOLOR="#0f172a"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><B>user_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#b45309"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name"><B>name</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(100)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="email"><B>email</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(255)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="password_hash"><B>password_hash</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(255)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="phone"><B>phone</B> ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(20)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="role"><B>role</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(10)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="status"><B>status</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(20)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><B>created_at</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamp</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at"><B>updated_at</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamp</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
