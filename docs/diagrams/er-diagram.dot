  itinerary_slots [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#0f172a"><TR><TD COLSPAN="3" BGCOLOR="#0f172a"><FONT COLOR="white"><B>itinerary_slots</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="slot_id"><B>slot_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#b45309"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="trip_id"><B>trip_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#b45309"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="destination_id"><B>destination_id</B> ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#b45309"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="mongo_doc_id"><B>mongo_doc_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(24)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="slot_type"><B>slot_type</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(30)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="title"><B>title</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(200)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="start_time"><B>start_time</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamp</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="end_time"><B>end_time</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamp</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="is_locked"><B>is_locked</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">boolean</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="created_by"><B>created_by</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#b45309"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><B>created_at</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamp</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  payments [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#0f172a"><TR><TD COLSPAN="3" BGCOLOR="#0f172a"><FONT COLOR="white"><B>payments</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="payment_id"><B>payment_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#b45309"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="expense_id"><B>expense_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#b45309"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="paid_by"><B>paid_by</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#b45309"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="amount"><B>amount</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">numeric(12,2)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="payment_method"><B>payment_method</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(50)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="transaction_id"><B>transaction_id</B> ?</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(100)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="paid_at"><B>paid_at</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">timestamp</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="status"><B>status</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar(20)</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
